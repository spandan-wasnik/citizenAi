# Copy to .env and fill in. NEVER commit .env or put real keys in this file.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/citizenassist.db

# Required when APP_ENV=production. Generate a long random string.
JWT_SECRET=

# LLM provider: none | openai | ollama
# "none" = extractive mode (answers built from retrieved sources, no LLM).
# If the chosen provider is incomplete, the app falls back to "none" and says so.
LLM_PROVIDER=none

OPENAI_API_KEY=
# Set this to a model name your OpenAI account has access to.
OPENAI_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Local embedding model (Phase 3)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

GUEST_SESSION_TTL_HOURS=24
